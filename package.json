{
  "name": "clear-clip-names",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/extension.js",
  "description": "Ableton Live Extension: clears the names of all clips on the selected track(s) within the current Arrangement time selection.",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:production": "tsc --noEmit && tsx build.ts --production",
    "package": "npm run build:production && extensions-cli package",
    "start": "tsx build.ts && extensions-cli run"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:./vendor/ableton-extensions-sdk-1.0.0-beta.0.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:./vendor/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@types/node": "^25.0.10",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
